# Google Cloud Console:
# 1) Enable Maps JavaScript API
# 2) Enable Places API (New)  [required for PlaceAutocompleteElement]
# 3) Restrict key by HTTP referrer: http://localhost:5173/*
VITE_GOOGLE_MAPS_API_KEY=your_api_key_here

# Optional favourites Spring Boot API
VITE_FAVORITES_API_URL=http://localhost:8081/api
